rules_version = '2';

// ================================================================
// כללי אבטחה ל"הזמר במסכה".
//
// האפליקציה נבנתה במכוון כך שלקהל אין שום התחברות (לא Google, לא
// Claude, לא כלום) — הזיהוי היחיד הוא השם שמקלידים בכניסה, בדיוק
// כפי שנדרש. המשמעות: אי אפשר לאכוף בצד השרת "מי מותר לו לכתוב מה"
// לפי משתמש מחובר, כי אין בכלל משתמשים מחוברים.
//
// לכן הכללים כאן פתוחים במכוון לקריאה/כתיבה בארבע האוספים שהאפליקציה
// באמת משתמשת בהם, וכל השאר חסום. ההגנה על מסך הניהול היא ה-PIN
// שמוגדר ב-config.js (ADMIN_PIN) בצד הלקוח בלבד — בדיוק כפי שהיה
// בגרסת האב-טיפוס (שם ה"הגנה" היחידה הייתה גם היא PIN בצד הלקוח).
//
// אם בעתיד תרצו הקשחה נוספת (למשל: רק admin.html יכול לשנות את
// state/admin), הדרך הנכונה היא הוספת אימות אמיתי (Firebase
// Anonymous/Custom Auth + בדיקת custom claim) — אבל זה משנה את
// האופי הבסיסי של האפליקציה (שהיה מכוון: בלי התחברות לקהל), ולכן לא
// נכלל כאן כברירת מחדל.
// ================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // state/admin — מצב האירוע החי (שלב נוכחי, שיר נוכחי, האם ההצבעה
    // פתוחה, סדר החשיפה המחושב, מי נחשף עד כה).
    match /state/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // participants/{pid} — מסמך אחד לכל מי שהקליד שם ונכנס.
    match /participants/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // votes/{song}_{pid} — ניחוש של משתתף/ת עבור ביצוע מסוים.
    match /votes/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // bestVotes/{pid} — ההצבעה הסופית "מי היה הביצוע הכי טוב".
    match /bestVotes/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // כל השאר חסום.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
